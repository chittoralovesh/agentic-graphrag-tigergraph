# --- LLM (Google AI Studio free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# optional extra keys: free-tier quotas are per key, per model
GEMINI_API_KEY_2=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- TigerGraph (local Community Edition in Docker) ---
TG_HOST=http://127.0.0.1
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_GRAPHNAME=OlympicGraphRAG
GEMINI_MODEL_POOL=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest
GEMINI_RPM=10
